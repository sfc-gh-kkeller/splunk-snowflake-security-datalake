# ============================================================
# Environment Variables for Vector Ingestion Demo
# ============================================================
# Copy this file to .env and update with your credentials:
#   cp env.example .env
# ============================================================

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password

# Key-pair auth (optional — preferred over password for production)
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SECURITY_LOGS
SNOWFLAKE_SCHEMA=PUBLIC
# Use a scoped role — avoid ACCOUNTADMIN in production
SNOWFLAKE_ROLE=SYSADMIN

# Splunk HEC (HTTP Event Collector)
# Find your HEC URL and token in Splunk Cloud settings
SPLUNK_HEC_URL=https://your-instance.splunkcloud.com:8088
SPLUNK_HEC_TOKEN=your-hec-token
SPLUNK_INDEX=security_logs

# PostgreSQL (local instance)
PGHOST=localhost
PGPORT=5432
PGDATABASE=demo_app
