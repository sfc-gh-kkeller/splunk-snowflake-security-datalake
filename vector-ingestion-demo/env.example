# ============================================================
# Environment Variables for Vector Ingestion Demo
# ============================================================
# Copy this file to .env and update with your credentials:
#   cp env.example .env
# ============================================================

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SECURITY_LOGS
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Splunk HEC (HTTP Event Collector)
# Find your HEC URL and token in Splunk Cloud settings
SPLUNK_HEC_URL=https://your-instance.splunkcloud.com:8088
SPLUNK_HEC_TOKEN=your-hec-token
SPLUNK_INDEX=security_logs

# PostgreSQL (local instance)
PGHOST=localhost
PGPORT=5432
PGDATABASE=demo_app
